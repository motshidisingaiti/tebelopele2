# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# AI provider (Anthropic Claude) — used by src/services/aiService.js
# Leave blank to run in rule-based fallback mode (no external calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# WhatsApp Cloud API — used by src/services/whatsappService.js
# Leave blank to run in simulation mode (logs instead of sending).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=tebelopele-verify

# Seed admin account (created on first run if no users exist)
SEED_ADMIN_EMAIL=admin@tebelopele.org.bw
SEED_ADMIN_PASSWORD=change-me-immediately
